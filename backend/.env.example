# Copy this file to .env and fill in your values

# Required: Your Anthropic API key (get one at https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: Port for the backend server (default: 4000)
PORT=4000

# Optional: Override Chrome path if auto-detection fails
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Required to enable the training endpoints (/api/train, /api/training/...).
# Trainers must send this value as the X-Trainer-Passcode header. If unset,
# all trainer endpoints respond 503 and the corpus stays read-only.
# TRAINER_PASSCODE=pick-a-shared-passcode

# Optional: APK upload size limit in MB (default 500)
# APK_MAX_SIZE_MB=500

# Optional: which retrieval backend to use (default bm25)
# RETRIEVAL_PROVIDER=bm25

# Optional: Google Sheets export (Apps Script web app URL + shared secret)
# APPS_SCRIPT_URL=your_apps_script_exec_url
# SHARED_SECRET=your_shared_secret

# Groq (any one AI key is enough)
# GROQ_API_KEY=your_groq_key_here
# GROQ_MODEL=openai/gpt-oss-120b
